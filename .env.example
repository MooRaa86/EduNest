# ==============================================================================
# EduNest Environment Configuration Template (.env.example)
# Resolution: DEP-07 / D-22 / P6-01 (EB-72)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development or Docker runs.
# 2. Never commit actual secret values (passwords, JWT secrets, API keys) to git.
# 3. For cloud deployments (Railway / Render / Staging), configure these variables
#    directly in the platform environment variable settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Profile Settings
# ------------------------------------------------------------------------------
# HTTP port for the Spring Boot embedded container (defaults to 8080 if unset).
# Platforms like Railway and Render inject PORT dynamically.
PORT=8080

# Active Spring Profile: 'prod' enables strict security chain, Flyway validation,
# and disables open-access dev endpoints. Always use 'prod' in production.
SPRING_PROFILES_ACTIVE=prod

# Transitional JWT backward compatibility (set to 'false' once FE uses Authorization headers exclusively)
APP_AUTH_RETURN_TOKEN_IN_BODY=true

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Full JDBC URL to PostgreSQL. For Supabase, use the connection pooler or direct connection:
# e.g., jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/edunest_db?sslmode=disable

# Database user (note: in EduNest properties, DATABASE_NAME binds to spring.datasource.username)
DATABASE_NAME=postgres

# Database password
DATABASE_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Base64-encoded or raw 256-bit secret string (minimum 32 characters/bytes).
# Boot FAILS FAST if missing, blank, under 32 bytes, or set to legacy default.
JWT_SECRET=generate_a_random_cryptographic_secret_key_at_least_32_bytes_long

# ------------------------------------------------------------------------------
# 4. Commission Rate Seeding (Day-1 Baseline / EB-47 / D-17)
# ------------------------------------------------------------------------------
# Default platform commission percentage for initial Flyway seed V4.
# Dynamic updates by Admin in UI will persist in the database and override this seed.
APP_COMMISSION_DEFAULT=10.0

# ------------------------------------------------------------------------------
# 5. SMTP Mail Service
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password_here

# ------------------------------------------------------------------------------
# 6. Zoom Live Meeting Integration (EB-85 / D-29)
# ------------------------------------------------------------------------------
# Master switch: set to 'true' once Server-to-Server OAuth credentials are ready.
# When 'false', a no-op placeholder client is used and no external calls are made.
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BASE_URL=https://api.zoom.us/v2

# ------------------------------------------------------------------------------
# 7. Supabase Storage (S3-Compatible API / EB-83 / D-25)
# ------------------------------------------------------------------------------
# Master switch for Supabase S3 file storage (avatars, attachments, materials).
SUPABASE_STORAGE_ENABLED=false
SUPABASE_URL=https://ciogysvcykzxrjuskxmk.supabase.co
SUPABASE_S3_ENDPOINT=https://ciogysvcykzxrjuskxmk.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_STORAGE_PUBLIC_BUCKET=edunest-public
SUPABASE_STORAGE_PRIVATE_BUCKET=edunest-private

# ------------------------------------------------------------------------------
# 8. Live Session Housekeeping & Attendance (EB-57 / D-15 / D-29)
# ------------------------------------------------------------------------------
APP_LIVESESSION_AUTO_CLOSE_ENABLED=true
APP_LIVESESSION_AUTO_CLOSE_GRACE_MINUTES=10
APP_LIVESESSION_AUTO_CLOSE_MAX_DURATION_MINUTES=40
APP_LIVESESSION_AUTO_CLOSE_SWEEP_RATE_MS=300000

# Attendance policy (dormant by default per D-15)
APP_LIVESESSION_ATTENDANCE_ENFORCED=false
APP_LIVESESSION_ATTENDANCE_PASS_THRESHOLD=75
APP_LIVESESSION_ATTENDANCE_SNAPSHOT_GRID_MINUTES=5
APP_LIVESESSION_ATTENDANCE_BONUS_POINTS=5
APP_LIVESESSION_ATTENDANCE_ABSENCE_FLOOR=0
